#!/usr/bin/env python3
"""hsi — rank what needs a human, and never show more than three.

  hsi items.json                 the top 3, with the ranking rule stated
  hsi items.json --all           everything, grouped by kind
  hsi items.json --why ID        why that one ranked where it did
  hsi done setpoint.json         Door 2 as a file: the five answers; exit 2 if done has no check
  hsi items.json --use FILE      read the usage record; if nothing was answered in 14 days,
                                 say that and show nothing else
  hsi answered --use FILE        record that the operator answered something today
  hsi --schema                   the input contract

WHY A HARD CAP OF THREE. A list of twenty-seven is a list of zero. The scarce resource
is not the operator's willingness, it is their attention in one sitting, and an
unranked board spends it on whatever happens to be at the top.

WHY THE RANKING IS PRINTED EVERY TIME. A hidden ranking is a judgement the operator
cannot audit. `--why` shows the arithmetic for any single item, and `--all` shows what
was held back -- the rest is one keystroke away, never gone.

WHY A USAGE RECORD. The README promises that if this goes two weeks unopened, that is the
finding and it should be reported rather than answered with more features. A promise nobody
measures is decoration. `--use` measures it: when the last answer is older than
FURNITURE_DAYS, the only thing printed is that nobody is using this. Reporting that IS the
job, and it costs one date in one file.

WHY A SETPOINT. Door 2 is the reference the work is measured against. Written as a file,
it can be cited before work starts and compared against when work ends. `hsi done` prints
it back and refuses a done with no external check of a known type. It checks the SHAPE of
the check, not whether the check proves anything; reading that is still a person's job.

This reads a plain JSON contract and nothing else. It knows nothing about any
particular setup, calendar or tracker; an adapter produces the contract. See
`hsi --schema` and adapters/ for a worked example.
"""
import datetime
import json
import os
import re
import sys

KINDS = ("DECIDE", "APPROVE", "EXECUTE", "TASTE")

# Two weeks, taken from the README's own sentence rather than tuned. It is the number that
# was promised, so it is the number that gets measured.
FURNITURE_DAYS = 14

# Every flag this tool accepts. An unknown flag is refused rather than ignored: a typo in
# --use would otherwise print a perfectly normal board, which is the detector failing in
# exactly the way it exists to detect.
FLAGS = {"--all", "--schema"}
FLAGS_WITH_VALUE = {"--why", "--use", "--today"}
BASES = ("Data", "Estimate", "Assumption", "Opinion")

# A check is something outside the model: a command that exits, a number that moves, a
# person who uses the thing. Each type names the one field that says HOW, plus `expect`.
# A person check with no `who` of its own is the setpoint's `who`: one fact, one place.
CHECKS = {"command": "cmd", "number": "measure", "person": "who"}

# Phrases that are a judgment, not a check, matched as whole phrases in `done` and in the
# check. Deliberately short: it catches the example the SKILL names and its near
# neighbors. A longer list would start guessing at meaning.
NOT_A_CHECK = ("looks good", "look good", "looks right", "look right", "feels right",
               "feel right")

SCHEMA = {
    "items": [{
        "id": "short-slug",
        "kind": "DECIDE | APPROVE | EXECUTE | TASTE",
        "question": "Phrased so it can be answered in a sentence. NOT a status line.",
        "why_you": "Why this needs a person and not the machine.",
        "options": [{"label": "...", "consequence": "what follows if chosen"}],
        "recommend": "optional: which option, and why",
        "if_ignored_30d": "what actually happens",
        "blocks": ["who or what is waiting"],
        "reversible": "yes | partly | no",
        "cost": "minutes | a decision | money | a conversation",
        "deadline": "YYYY-MM-DD, or null. A HARD EXTERNAL date only.",
        "evidence": "file:line, or a command that reproduces it",
    }],
    "setpoint": {
        "id": "short-slug. Work cites this before it starts: no id, no start.",
        "who": "1. Who uses the finished thing. One person beats 'the team'.",
        "when": "1. The moment they use it.",
        "enables": "2. What it lets them do that they cannot do today.",
        "wrong_if": "3. What would make them say 'that is not what I wanted'.",
        "done": "4. ONE checkable sentence, external to the model.",
        "check": {
            "type": "command | number | person. 'It looks good' is none of these.",
            "cmd": "type command: what to run",
            "measure": "type number: where the number is read",
            "who": "type person: optional; the setpoint's who when absent",
            "expect": "command: the exit code; number: the value that means done; person: what they do",
        },
        "out_of_scope": ["5. What this will not do, written down so the work cannot grow quietly."],
        "invalidated_by": ["What would change this answer. A condition, never a timer."],
        "words": "The operator's own words, verbatim: the request as they first put it.",
        "date": "YYYY-MM-DD",
        "basis": "Data | Estimate | Assumption | Opinion",
    },
}


def score(it):
    """Return (points, explanation). Deliberately simple and inspectable.

    A weighting nobody can recompute by hand is a weighting nobody will trust. Four
    terms, stated in the SKILL, and a hard deadline dominates by construction rather
    than by out-weighing everything else numerically.
    """
    why, pts = [], 0
    rev = str(it.get("reversible", "")).lower()
    if rev == "no":
        pts += 40; why.append("+40 irreversible")
    elif rev == "partly":
        pts += 20; why.append("+20 partly reversible")
    n = len(it.get("blocks") or [])
    if n:
        pts += 15 * min(n, 3); why.append(f"+{15*min(n,3)} blocks {n}")
    ign = (it.get("if_ignored_30d") or "").lower()
    if any(w in ign for w in ("forfeit", "penalt", "expire", "lost", "closes", "late", "unrecover")):
        pts += 30; why.append("+30 inaction has a named cost")
    if it.get("kind") == "EXECUTE":
        pts += 10; why.append("+10 only they have the hands")
    return pts, why


def order(items):
    """Hard deadlines first by date, then everything else by points."""
    dated = sorted([i for i in items if i.get("deadline")], key=lambda i: i["deadline"])
    rest = sorted([i for i in items if not i.get("deadline")],
                  key=lambda i: -score(i)[0])
    return dated + rest


def show(it, n=None):
    head = f"{n}. " if n else "   "
    print(f"\n{head}[{it.get('kind','?')}] {it.get('question','(no question)')}")
    if it.get("deadline"):
        print(f"      BY {it['deadline']}")
    if it.get("why_you"):
        print(f"      needs you: {it['why_you']}")
    for o in (it.get("options") or []):
        print(f"        - {o.get('label','?')} — {o.get('consequence','')}")
    if it.get("recommend"):
        print(f"      I'd suggest: {it['recommend']}")
    if it.get("if_ignored_30d"):
        print(f"      if ignored: {it['if_ignored_30d']}")
    bits = [b for b in (it.get("cost"), f"blocks {', '.join(it['blocks'])}" if it.get("blocks") else None) if b]
    if bits:
        print(f"      {' · '.join(bits)}")
    if it.get("evidence"):
        print(f"      evidence: {it['evidence']}")


def filled(v):
    """A value that says something: a non-blank string, or a number that is not a bool."""
    if isinstance(v, str):
        return bool(v.strip())
    return isinstance(v, (int, float)) and not isinstance(v, bool)


def check_parts(sp):
    """(type, how, expect) of the check, each None when absent or malformed."""
    chk = sp.get("check")
    if not isinstance(chk, dict):
        return None, None, None
    t = chk.get("type")
    t = t if isinstance(t, str) and t in CHECKS else None
    how = chk.get(CHECKS[t]) if t else None
    if t == "person" and not filled(how):
        how = sp.get("who")
    return t, (how if filled(how) else None), (chk.get("expect") if filled(chk.get("expect")) else None)


def not_checkable(sp):
    """Return the reasons done is NOT checkable. Empty means it is.

    Checkable here means a `check` of a known type with its HOW field and `expect` filled
    in, and no stock judgment phrase in `done` or the check. That is a test of SHAPE. It
    cannot tell a check that proves done from one that does not, and does not pretend to.
    """
    why = []
    d = sp.get("done")
    done = d.strip() if isinstance(d, str) else ""
    if d is not None and not isinstance(d, str):
        why.append("done must be one sentence, not a list, a number or an object")
    elif not done:
        why.append("there is no done sentence")
    chk = sp.get("check")
    t, how, expect = check_parts(sp)
    if not isinstance(chk, dict):
        why.append("there is no check: a command that exits, a number that moves, "
                   "or a person who uses it")
    elif not t:
        why.append(f"check.type {chk.get('type')!r} is not command | number | person")
    else:
        missing = [f for f, v in ((CHECKS[t], how), ("expect", expect)) if v is None]
        if missing:
            why.append(f"a {t} check needs {' and '.join(missing)}")
    text = " ".join(str(x) for x in (done, how, expect) if x is not None).lower()
    why += [f"'{p}' is a judgment, not a check" for p in NOT_A_CHECK
            if re.search(rf"(?<![\w-]){re.escape(p)}(?![\w-])", text)]
    return why


def listed(v):
    """A field that should be a list may arrive as one string; print either the same way."""
    if isinstance(v, list):
        return " · ".join(str(x) for x in v if filled(x))
    return v.strip() if isinstance(v, str) else ""


def show_setpoint(sp):
    basis = f" [{sp['basis']}]" if sp.get("basis") else " (basis not labeled)"
    print(f"Setpoint {sp['id']}, {sp.get('date') or 'undated'}{basis}")
    asked = f'"{sp["words"]}"' if filled(sp.get("words")) else "(request not recorded)"
    print(f"  asked as:     {asked}\n")
    who = " · ".join(str(sp[k]) for k in ("who", "when") if filled(sp.get(k)))
    rows = (("1. who, when", who),
            ("2. lets you", sp.get("enables")),
            ("3. wrong if", sp.get("wrong_if")),
            ("4. done when", sp.get("done") if isinstance(sp.get("done"), str) else None))
    for label, v in rows:
        print(f"  {label + ':':<14}{v if filled(v) else '(not answered)'}")
    t, how, expect = check_parts(sp)
    if isinstance(sp.get("check"), dict):
        print(f"  {'':<14}check, {t or '?'}: {how if how is not None else '?'} · "
              f"expect {expect if expect is not None else '?'}")
    print(f"  {'5. not doing:':<14}"
          f"{listed(sp.get('out_of_scope')) or '(nothing written: this is what stops the work growing quietly)'}")
    print(f"\n  re-ask if:    "
          f"{listed(sp.get('invalidated_by')) or '(nothing recorded: this answer rules until someone notices)'}")


def done_cmd(args):
    """`hsi done FILE`: print the setpoint; exit 2 if it cannot be cited or checked."""
    if not args:
        print("hsi done: give a setpoint file. `hsi --schema` shows the shape.", file=sys.stderr)
        return 2
    try:
        # utf-8-sig: a file saved on Windows often starts with a byte-order mark.
        data = json.load(open(args[0], encoding="utf-8-sig"))
    except (OSError, ValueError, RecursionError) as e:
        print(f"hsi: cannot read {args[0]}: {type(e).__name__}", file=sys.stderr); return 2
    if isinstance(data, dict) and "setpoint" not in data and not ({"id", "done", "check"} & set(data)):
        print(f"hsi: no setpoint in {args[0]} (found: {', '.join(map(str, data)) or 'nothing'}). "
              f"`hsi --schema` shows the shape.", file=sys.stderr)
        return 2
    sp = data.get("setpoint", data) if isinstance(data, dict) else None
    if not isinstance(sp, dict):
        print("hsi: expected {\"setpoint\": {...}} or a bare setpoint object", file=sys.stderr)
        return 2
    if not (isinstance(sp.get("id"), str) and sp["id"].strip()):
        print("hsi: this setpoint has no usable id. Work cites the id before it starts, so it "
              "must be a non-blank string.", file=sys.stderr)
        return 2
    if sp.get("basis") and sp["basis"] not in BASES:
        print(f"hsi: basis {sp['basis']!r} is not {' | '.join(BASES)}", file=sys.stderr); return 2

    show_setpoint(sp)
    why = not_checkable(sp)
    if why:
        print(f"\nNOT CHECKABLE, so no work starts against {sp['id']}:")
        for w in why:
            print(f"  - {w}")
        print("Shrink done until a command exits, a number moves, or a person does something you")
        print("can watch. A smaller done that can be checked beats a larger one that cannot.")
        return 2
    open_q = [n for n, k in (("1", "who"), ("2", "enables"), ("3", "wrong_if"), ("5", "out_of_scope"))
              if not (listed(sp.get(k)) if k == "out_of_scope" else filled(sp.get(k)))]
    print(f"\nDone is checkable. Work against this cites setpoint {sp['id']}.")
    if open_q:
        print(f"Still unanswered: question{'s' if len(open_q) > 1 else ''} {', '.join(open_q)}. "
              f"The check does not need them; the work probably does.")
    return 0


def today(argv):
    """--today exists so a test can fix the clock. Nothing else should pass it."""
    if "--today" in argv:
        return datetime.date.fromisoformat(argv[argv.index("--today") + 1])
    return datetime.date.today()


def read_use(path):
    """The usage record: one date, the last time a person answered something.

    Missing is not stale. A file that has never existed means nobody has recorded an
    answer yet, which is a first run rather than neglect, and saying otherwise would cry
    wolf on day one.
    """
    if not path or not os.path.exists(path):
        return None
    try:
        d = json.load(open(path, encoding="utf-8")).get("last_answered_at")
        return datetime.date.fromisoformat(d) if d else None
    except (OSError, ValueError, AttributeError):
        return None


def answered_cmd(argv):
    """`hsi answered --use FILE`: stamp today. This is the only writer."""
    if "--use" not in argv:
        print("hsi answered: --use FILE says where to record it", file=sys.stderr); return 2
    path = argv[argv.index("--use") + 1]
    day = today(argv)
    os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
    json.dump({"last_answered_at": day.isoformat()}, open(path, "w", encoding="utf-8"))
    print(f"recorded: an answer on {day}. That is what keeps this from reporting itself as furniture.")
    return 0


def refuse_unknown_flags(argv):
    """An unrecognised flag is an error, not a shrug.

    This used to be silent, and the failure it hid is the worst kind here: `--sittng` or
    `--us` would print a full, healthy-looking board while the usage check never ran.
    """
    args = argv[1:]
    i = 0
    while i < len(args):
        a = args[i]
        if a.startswith("-"):
            if a in FLAGS_WITH_VALUE:
                if i + 1 >= len(args):
                    print(f"hsi: {a} needs a value", file=sys.stderr); return 2
                i += 1
            elif a not in FLAGS:
                print(f"hsi: unknown flag {a}. Known: "
                      f"{', '.join(sorted(FLAGS | FLAGS_WITH_VALUE))}", file=sys.stderr)
                return 2
        i += 1
    return 0


def main(argv):
    if len(argv) > 1 and argv[1] == "done":
        return done_cmd(argv[2:])
    if len(argv) > 1 and argv[1] == "answered":
        return answered_cmd(argv)
    rc = refuse_unknown_flags(argv)
    if rc:
        return rc
    if "--schema" in argv:
        print(json.dumps(SCHEMA, indent=2)); return 0
    paths = [a for a in argv[1:] if not a.startswith("-")]
    skip = set()
    for f in FLAGS_WITH_VALUE:
        if f in argv:
            skip.add(argv[argv.index(f) + 1])
    paths = [p for p in paths if p not in skip]
    if not paths:
        print(__doc__); return 0
    try:
        data = json.load(open(paths[0], encoding="utf-8"))
    except (OSError, ValueError) as e:
        print(f"hsi: cannot read {paths[0]}: {type(e).__name__}", file=sys.stderr); return 2
    items = data.get("items") if isinstance(data, dict) else data
    if not isinstance(items, list):
        print("hsi: expected {\"items\": [...]} or a bare list", file=sys.stderr); return 2

    bad = [i.get("id", "?") for i in items if i.get("kind") not in KINDS]
    if bad:
        print(f"hsi: {len(bad)} item(s) have no valid kind: {', '.join(map(str,bad[:5]))}",
              file=sys.stderr)
        print(f"     kind must be one of {', '.join(KINDS)} — an item that is none of "
              f"these does not belong in front of a person.", file=sys.stderr)
        return 2

    if "--why" in argv:
        want = argv[argv.index("--why") + 1]
        for it in items:
            if it.get("id") == want:
                pts, why = score(it)
                print(f"{want}: {pts} points" + (f", deadline {it['deadline']} (deadlines sort first)"
                                                 if it.get("deadline") else ""))
                for w in why: print(f"  {w}")
                if not why: print("  (nothing scored — reversible, blocks nobody, no named cost)")
                return 0
        print(f"hsi: no item with id {want!r}", file=sys.stderr); return 2

    # The bandwidth check, before anything is ranked. If nobody has answered in two weeks,
    # the only honest item is that nobody is using this — and it replaces the board rather
    # than sitting at the top of it, because a fourth item beside three real ones is how
    # this gets ignored.
    if "--use" in argv:
        last = read_use(argv[argv.index("--use") + 1])
        if last is not None:
            idle = (today(argv) - last).days
            if idle >= FURNITURE_DAYS:
                print(f"Nothing here has been answered in {idle} days.")
                print("That is the finding, and it is the only one worth printing today: this "
                      "is furniture.")
                print("Do not add adapters, items or features this week. Ask whether the "
                      "three questions are")
                print("the wrong three, whether the moment is wrong, or whether nobody "
                      "needed them in the first place.")
                print(f"\nThe board is still there:  hsi {paths[0]} --all")
                return 0

    ranked = order(items)
    if "--all" in argv:
        print(f"ALL {len(ranked)} item(s), grouped by kind\n")
        for k in KINDS:
            grp = [i for i in ranked if i.get("kind") == k]
            if not grp: continue
            print(f"--- {k} ({len(grp)}) ---")
            for it in grp: show(it)
            print()
        return 0

    top, rest = ranked[:3], ranked[3:]
    if not top:
        print("Nothing needs you. That is the update, not an absence of one.")
        return 0
    print(f"{len(top)} of {len(ranked)} thing(s) need you. Ranked by: hard deadline first,")
    print("then irreversibility, who is blocked, and the cost of doing nothing for 30 days.")
    for n, it in enumerate(top, 1):
        show(it, n)
    if rest:
        print(f"\n{len(rest)} more held back, one keystroke away:  hsi {paths[0]} --all")
        print("Held back means ranked lower, never dropped. `--why ID` shows the arithmetic.")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
